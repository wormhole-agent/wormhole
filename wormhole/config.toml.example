# wormhole/config.toml.example
#
# Copy to ~/wormhole/config.toml on first run (or let `wormhole init` do it).
# Every section has a comment block. Values starting with `<...>` are placeholders
# you replace with your own. API keys live in the DPAPI vault, NOT here.

# --------------------------------------------------------------------
# General paths
# --------------------------------------------------------------------
# Where the binary stores its per-user state (token, sessions, logs, vault).
# Defaults to ~/wormhole/. Override only if you know why you need to.
[paths]
state_dir     = "~/wormhole"
workspace_dir = "~/wormhole/workspace"
logs_dir      = "~/wormhole/logs"

# --------------------------------------------------------------------
# UI: the embedded dashboard + /api/* surface
# --------------------------------------------------------------------
# Loopback by default. Do NOT change to 0.0.0.0 unless you understand the
# implications and have a reverse proxy with auth in front.
[ui]
bind         = "127.0.0.1"
port         = 18790
# Hard CORS allowlist. Same-origin is sufficient now that the dashboard is
# co-served from this binary. Add more entries only if you split origins.
cors_origins = ["http://127.0.0.1:18790"]
# Token gate. Auto-generated on first boot if not set. Stored at
# ~/wormhole/.token with owner-only ACL. Never logged, never in URLs.
# token = "<auto-generated-on-first-boot>"

# --------------------------------------------------------------------
# Providers
# --------------------------------------------------------------------
# Keys are read from env first, then the DPAPI vault, then this file.
# DO NOT put real keys in this file. The vault is the right place.

[providers.anthropic]
enabled    = true
model      = "claude-sonnet-4-6"
# api_key  = "<read from env ANTHROPIC_API_KEY or vault>"

[providers.openai_compat]
# Same wire format covers OpenAI and DeepSeek (different base_url).
enabled    = true
base_url   = "https://api.openai.com/v1"
model      = "gpt-5.5"
# api_key  = "<read from env OPENAI_API_KEY or vault>"

[providers.deepseek]
enabled    = true
base_url   = "https://api.deepseek.com/v1"
model      = "deepseek-chat"
# api_key  = "<read from env DEEPSEEK_API_KEY or vault>"

[providers.ollama]
enabled    = true
base_url   = "http://127.0.0.1:11434"
model      = "llama3.2:3b"

# Order the brain walks when a provider fails or rate-limits.
[fallback]
chain = ["anthropic", "openai_compat", "deepseek", "ollama"]

# --------------------------------------------------------------------
# Telegram (optional)
# --------------------------------------------------------------------
# Bot token is read from env TELEGRAM_BOT_TOKEN or the vault.
[telegram]
enabled = false
# allowed_chat_ids = []  # if non-empty, only these chats can talk to the bot

# --------------------------------------------------------------------
# Cron
# --------------------------------------------------------------------
# Top-level cron jobs live in cron.toml. Per-area jobs live in cron.d/*.toml.
# Schema is documented in wiki/Reference/Cron-Schema.md.
[cron]
enabled        = true
state_path     = "~/wormhole/cron-state.json"
runs_log_path  = "~/wormhole/logs/cron-runs.jsonl"

# --------------------------------------------------------------------
# Memory
# --------------------------------------------------------------------
# Per-turn memory injection caps. Don't blow your context window.
[memory]
include_soul         = true
include_user         = true
include_long_term    = true
include_today        = true
include_yesterday    = true
max_total_chars      = 60000

# --------------------------------------------------------------------
# Tools
# --------------------------------------------------------------------
# Sandbox for the write_file tool. Any path passed to write_file must
# be inside one of these. The default tightens to your workspace; widen
# only if you understand why.
[tools]
write_file_allowed_paths = ["~/wormhole/workspace", "~/wormhole/openbrain/data"]
allow_shell              = true
shell_timeout_seconds    = 60

# --------------------------------------------------------------------
# Prompt caching (Anthropic)
# --------------------------------------------------------------------
# Mirrors Anthropic's ephemeral and 1h cache tiers.
[prompt_caching]
enabled     = true
cache_tier  = "ephemeral"
# 1h tier costs more upfront but pays off for long-running sessions.
